# Sales Room (Proces OS) Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=./data/salesroom.db

# Authentication
JWT_SECRET=change_this_to_a_secure_random_string_min_32_chars
SESSION_TIMEOUT_HOURS=4

# AI Configuration (Required for AI features)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Search APIs (At least one required for Intent Scraper)
SERPER_API_KEY=your_serper_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Slack Integration (Optional but recommended)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# LinkedIn Enrichment (Optional - legacy, use PROXYCURL_API_KEY instead)
LINKEDIN_API_KEY=

# Deep Research - Social Media APIs
# LinkedIn via Proxycurl (Required for LinkedIn research - https://nubela.co/proxycurl)
PROXYCURL_API_KEY=

# Twitter/X API (Optional - https://developer.twitter.com)
TWITTER_BEARER_TOKEN=

# GitHub Personal Access Token (Optional - increases rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=

# Reddit API (Optional - https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Facebook Graph API (Optional, limited to public pages - https://developers.facebook.com)
FACEBOOK_ACCESS_TOKEN=

# Frontend URL (for CORS configuration)
FRONTEND_URL=http://localhost:5173
