# Sales Room (Proces OS) Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Server Configuration
# ============================================
PORT=3001
NODE_ENV=development

# ============================================
# Database
# ============================================
# Local development (SQLite):
# DATABASE_URL=./data/salesroom.db
#
# Production / Vercel (Neon PostgreSQL):
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ============================================
# Vercel Deployment
# ============================================
# Set automatically by Vercel (no need to configure manually):
# VERCEL=1

# Vercel Blob Storage (for file attachments in Sales Rooms)
# Get from: Vercel Dashboard > Storage > Blob > Tokens
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxx

# ============================================
# Authentication
# ============================================
JWT_SECRET=change_this_to_a_secure_random_string_min_32_chars
SESSION_TIMEOUT_HOURS=4

# ============================================
# AI Configuration (Required for AI features)
# ============================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: override default model (default: claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ============================================
# Search APIs (At least one required for Intent Scraper)
# ============================================
SERPER_API_KEY=your_serper_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# ============================================
# Frontend URL (for CORS configuration)
# ============================================
# Local development:
FRONTEND_URL=http://localhost:5173
# Production (Vercel):
# FRONTEND_URL=https://your-app.vercel.app

# Frontend env var (set in frontend/.env or Vercel dashboard):
# VITE_API_URL=/api

# ============================================
# Slack Integration (Optional)
# ============================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================
# Deep Research - Social Media APIs (Optional)
# ============================================

# LinkedIn via Proxycurl (Required for LinkedIn research - https://nubela.co/proxycurl)
PROXYCURL_API_KEY=

# Twitter/X API (Optional - https://developer.twitter.com)
TWITTER_BEARER_TOKEN=

# GitHub Personal Access Token (Optional - increases rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=

# Reddit API (Optional - https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Facebook Graph API (Optional, limited to public pages - https://developers.facebook.com)
FACEBOOK_ACCESS_TOKEN=

# ============================================
# TinyFish / AgentQL Enrichment (Optional)
# ============================================
TINYFISH_API_KEY=
TINYFISH_API_URL=https://api.agentql.com/v1
RESEARCH_PROVIDER=proxycurl
