# Sales Room (Proces OS) Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Server Configuration
# ============================================
PORT=3001
NODE_ENV=development

# ============================================
# Database
# ============================================
# Local development (SQLite):
# DATABASE_URL=./data/salesroom.db
#
# Production / Vercel (Neon PostgreSQL):
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ============================================
# Vercel Deployment
# ============================================
# Set automatically by Vercel (no need to configure manually):
# VERCEL=1

# Vercel Blob Storage (for file attachments in Sales Rooms)
# Get from: Vercel Dashboard > Storage > Blob > Tokens
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxx

# ============================================
# Authentication
# ============================================
JWT_SECRET=change_this_to_a_secure_random_string_min_32_chars
SESSION_TIMEOUT_HOURS=4

# ============================================
# AI Configuration (Required for AI features)
# ============================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: override default model (default: claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ============================================
# Search APIs (At least one required for Intent Scraper)
# ============================================
SERPER_API_KEY=your_serper_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# ============================================
# Frontend URL (for CORS configuration)
# ============================================
# Local development:
FRONTEND_URL=http://localhost:5173
# Production (Vercel):
# FRONTEND_URL=https://your-app.vercel.app

# Frontend env var (set in frontend/.env or Vercel dashboard):
# VITE_API_URL=/api

# ============================================
# Slack Integration (Optional)
# ============================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================
# Deep Research - Social Media APIs
# ============================================

# Apify API (Primary provider for Twitter/Reddit/Facebook research)
# When set, Apify scraper actors are used for social media research
# Get from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# LinkedIn via Proxycurl (Optional - enriches LinkedIn research)
# Without it, LinkedIn research uses public profile scraping + DuckDuckGo/Google search
PROXYCURL_API_KEY=

# GitHub Personal Access Token (Optional - increases rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=
