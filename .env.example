# Sales Room (Proces OS) Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=./data/salesroom.db

# Authentication
JWT_SECRET=change_this_to_a_secure_random_string_min_32_chars
SESSION_TIMEOUT_HOURS=4

# AI Configuration (Required for AI features)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Search APIs (At least one required for Intent Scraper)
SERPER_API_KEY=your_serper_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Slack Integration (Optional but recommended)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# LinkedIn Enrichment (Optional)
LINKEDIN_API_KEY=

# Frontend URL (for CORS configuration)
FRONTEND_URL=http://localhost:5173
